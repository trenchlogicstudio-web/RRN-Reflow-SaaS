# Local development: node --env-file=.env local.js
APP_ENV=development
PORT=8787
DB_PATH=data/local.sqlite
PRODUCT_NAME=Reflow
OPERATOR_NAME=
CONTACT_EMAIL=
PUBLIC_ORIGIN=
ADMIN_KEY=
AUTH_PEPPER=
PBKDF2_ITERATIONS=100000
REQUIRE_EMAIL_VERIFICATION=off
MAIL_PROVIDER=console
MAIL_FROM="Reflow <requests@example.com>"
RESEND_API_KEY=
DEMO_MODE=on
# Configure ALL billing settings together. Blank = free beta.
BILLING_PROVIDER=
BILLING_MODE=test
CHECKOUT_URL=
BILLING_WEBHOOK_SECRET=
BILLING_API_KEY=
BILLING_PRICE_ID=
BILLING_PORTAL_URL=
PRICE_LABEL=
PRICE_MONTHLY_CENTS=
BILLING_CURRENCY=EUR
TRIAL_DAYS=30
BILLING_GRACE_DAYS=3
LEGAL_NOTICE=
